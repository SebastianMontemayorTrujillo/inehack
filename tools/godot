#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export XDG_DATA_HOME="$project_root/.tools/share"
export XDG_CONFIG_HOME="$project_root/.tools/config"
export XDG_CACHE_HOME="$project_root/.tools/cache"
exec "$project_root/.tools/godot/Godot_v4.7.2-stable_linux.x86_64" "$@"
